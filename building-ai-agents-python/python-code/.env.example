# Copy this file to .env and fill in your values. Never commit .env.

# Chat model, as provider:model-name (check your provider for current model names)
MODEL=anthropic:claude-sonnet-5-5

# Key for the provider above. Use the variable your provider expects.
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Embeddings (chapters 8 to 10). Default is OpenAI; uncomment for a local model instead.
# EMBEDDINGS=local

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=beginners-guide
# LANGSMITH_ENDPOINT=...   (needed for accounts hosted outside the US default region)
